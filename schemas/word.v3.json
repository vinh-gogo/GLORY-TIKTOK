{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LexiconWordV3",
  "description": "Mục từ trong data/lexicon/. v3: bỏ speaking_use, level.basis là danh sách mã nguồn, collocation có pattern + evidence dạng object, thêm synsets/review.reason.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "lemma", "pos", "ipa", "level", "topics", "senses", "review"],
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "lemma": { "type": "string", "minLength": 1 },
    "pos": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "ipa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["us"],
      "properties": {
        "us": { "type": "string", "pattern": "^/.+/$" },
        "uk": { "type": "string", "pattern": "^/.+/$" }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "us": { "type": "string" }, "uk": { "type": "string" } }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "basis"],
      "properties": {
        "band": { "enum": ["foundation", "core", "target", "advanced"] },
        "cefr": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "basis": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "freq_rank": {
          "type": "object",
          "additionalProperties": false,
          "required": ["list", "rank"],
          "properties": { "list": { "type": "string" }, "rank": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "topics": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" } },
    "senses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "meaning_vi"],
        "properties": {
          "id": { "type": "string" },
          "meaning_vi": { "type": "string", "minLength": 1 },
          "note_vi": { "type": "string" }
        }
      }
    },
    "collocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phrase", "meaning_vi", "evidence"],
        "properties": {
          "phrase": { "type": "string", "minLength": 1 },
          "pattern": { "enum": ["V+N", "ADJ+N", "N+N", "N+PREP", "V+PREP", "ADV+ADJ", "PHRASE"] },
          "meaning_vi": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "checked_at"],
            "properties": {
              "source": { "type": "string" },
              "checked_at": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "synsets": { "type": "array", "items": { "type": "string" } },
    "synonyms": {
      "description": "DEPRECATED (ADR-008): giữ tạm cho tới khi synset thay thế.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word"],
        "properties": { "word": { "type": "string" }, "meaning_vi": { "type": "string" } }
      }
    },
    "confused_words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["difference_vi"],
        "properties": {
          "ref": { "type": "string" },
          "word": { "type": "string" },
          "ipa": { "type": "string" },
          "meaning": { "type": "string" },
          "kind": { "enum": ["spelling", "sound", "spelling-sound", "meaning"] },
          "difference_vi": { "type": "string" }
        }
      }
    },
    "confusing_meanings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["difference_vi"],
        "properties": {
          "ref": { "type": "string" },
          "word": { "type": "string" },
          "meaning": { "type": "string" },
          "difference_vi": { "type": "string" }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["en", "vi"],
        "properties": { "en": { "type": "string" }, "vi": { "type": "string" }, "audio": { "type": "string" } }
      }
    },
    "pronunciation_tips_vi": { "type": "string" },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["ai_draft", "ai_cross_checked", "human_verified", "needs_review"] },
        "checked_by": { "type": "array", "items": { "type": "string" } },
        "checked_at": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" }
      }
    }
  }
}
