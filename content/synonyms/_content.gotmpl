{{- /* /synonyms/<id>/: một trang cho mỗi nhóm đồng nghĩa đã duyệt (data/synsets). Hiện chưa có nhóm nào → không sinh trang. */ -}}
{{- range $id, $s := site.Data.synsets }}
  {{- if in (slice "ai_cross_checked" "human_verified") $s.review.status }}
    {{- $page := dict
      "path" $s.id
      "title" $s.head_vi
      "kind" "page"
      "params" (dict "synset" $s "summary" (printf "Nhóm từ đồng nghĩa: %s" $s.head_vi))
    }}
    {{- $.AddPage $page }}
  {{- end }}
{{- end }}
