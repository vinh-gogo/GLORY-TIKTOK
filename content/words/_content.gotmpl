{{- /* Sinh /words/<id>/ từ data/lexicon (schema v3). MỌI mục từ đều có trang (ADR-009).
       Bản nháp (ai_draft/needs_review) có trang nhưng: noindex, không vào sitemap, có nhãn "chưa kiểm duyệt" và nút Báo lỗi. */ -}}
{{- $verified := slice "ai_cross_checked" "human_verified" }}
{{- $sortedWords := partialCached "words-all.html" . }}
{{- range $index, $word := $sortedWords }}
  {{- $isDraft := not (in $verified $word.review.status) }}
  {{- $meaning := (index $word.senses 0).meaning_vi }}
  {{- $page := dict
    "path" $word.id
    "title" $word.lemma
    "weight" (add $index 1)
    "kind" "page"
    "params" (dict
      "word_id" $word.id
      "lemma" $word.lemma
      "word_data" $word
      "summary" $meaning
      "topics" $word.topics
      "levels" (slice $word.level.band)
      "review_status" $word.review.status
      "robotsNoIndex" $isDraft
    )
  }}
  {{- if $isDraft }}{{ $page = merge $page (dict "sitemap" (dict "disable" true)) }}{{ end }}
  {{- $.AddPage $page }}
{{- end }}
