{{- $allWords := slice }}
{{- range $initial, $words := site.Data.lexicon }}
  {{- range $id, $word := $words }}
    {{- $allWords = $allWords | append $word }}
  {{- end }}
{{- end }}
{{- $sortedWords := sort $allWords "lemma" "asc" }}
{{- range $index, $word := $sortedWords }}
  {{- $meaning := "" }}
  {{- with $word.senses }}
    {{- $meaning = (index . 0).meaning_vi }}
  {{- end }}
  {{- $contentVal := printf "## Định nghĩa\n\n%s\n" $meaning }}
  {{- $contentDict := dict "mediaType" "text/markdown" "value" $contentVal }}
  {{- $page := dict
    "path" $word.id
    "title" $word.lemma
    "weight" (add $index 1)
    "kind" "page"
    "content" $contentDict
    "params" (dict
      "word_id" $word.id
      "lemma" $word.lemma
      "word_data" $word
      "summary" $meaning
      "topics" $word.topics
      "parts" $word.speaking_use
    )
  }}
  {{- $.AddPage $page }}
{{- end }}
